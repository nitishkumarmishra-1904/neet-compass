{
  "name": "NEET Compass",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "NEET Compass",
      "onAutoForward": "openPreview"
    }
  },
  "postStartCommand": "bash -lc 'nohup python3 -m http.server 8000 --bind 0.0.0.0 >/tmp/neet-compass-server.log 2>&1 < /dev/null &'"
}
